<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="MercaFlow PDV"
    Manufacturer="MercaFlow"
    Version="__VERSION__"
    UpgradeCode="{34CF953A-E0D8-4D2A-A624-F594095EE92A}"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Uma versao mais recente do MercaFlow PDV ja esta instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MercaFlow PDV" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PROGRAMMENUDIR" Name="MercaFlow ERP" />
    </StandardDirectory>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="{E56DC4E8-30EA-45C3-B321-7814C1787D03}">
      <File Id="SupermercadoPDVExe" Source="__SOURCE__" KeyPath="yes">
        <Shortcut
          Id="ProgramMenuShortcut"
          Directory="PROGRAMMENUDIR"
          Name="MercaFlow PDV"
          Description="PDV operacional do supermercado"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="yes" />
        <Shortcut
          Id="DesktopShortcut"
          Directory="DesktopFolder"
          Name="MercaFlow PDV"
          Description="PDV operacional do supermercado"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="yes" />
      </File>
      <RemoveFolder Id="RemoveProgramMenuFolder" Directory="PROGRAMMENUDIR" On="uninstall" />
    </Component>

    <Feature Id="MainFeature" Title="MercaFlow PDV" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>
