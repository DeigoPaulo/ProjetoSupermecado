DJANGO_ENV=development
DEBUG=true
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# SQLite local
SQLITE_PATH=db.sqlite3

# PostgreSQL, quando for usar em servidor
# POSTGRES_DB=supermercado
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60
# Caminhos opcionais quando o PostgreSQL Client não estiver no PATH
# POSTGRES_PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# POSTGRES_PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe

STATIC_ROOT=staticfiles
MEDIA_ROOT=media
LOG_DIR=logs
LOG_LEVEL=INFO

# Recuperacao de senha por e-mail
# Em desenvolvimento, o backend de console exibe o link no terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=nao-responda@supermercado.local

# Seguranca: os valores abaixo permitem desenvolvimento HTTP local.
# Em producao, use true/true/true, HSTS maior que zero e proxy reverso HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_PROTO=false
# Distribuicao do aplicativo instalado nos caixas
PDV_DESKTOP_VERSION=0.1.11
PDV_DESKTOP_MIN_VERSION=0.1.9
PDV_DESKTOP_RELEASE_CHANNEL=ESTAVEL
PDV_TEF_SIMULATOR_ENABLED=False
PDV_DESKTOP_INSTALLER_PATH=artifacts/DeTecPDV.exe
PDV_DESKTOP_REQUIRE_SIGNED_INSTALLER=true

# Consulta opcional de CNPJ/CEP para preencher cadastros
# Use {cnpj}, {cep} ou {valor} na URL, ou deixe sem placeholder para enviar query string.
CADASTRO_CNPJ_PROVIDER_URL=https://brasilapi.com.br/api/cnpj/v1/{cnpj}
CADASTRO_CEP_PROVIDER_URL=https://brasilapi.com.br/api/cep/v2/{cep}
CADASTRO_LOOKUP_TIMEOUT_SEGUNDOS=5

# Adaptador opcional para envio do fechamento ao provedor contabil homologado
# Informe o caminho Python da classe que implementa exportar(payload=..., chave_idempotencia=...).
FINANCEIRO_CONTABIL_ADAPTER=
FINANCEIRO_EXTRATO_ADAPTERS_JSON={}

# Adaptadores permitidos por provedor. Os caminhos Python ficam somente no servidor.
# MARKETPLACE_PARTNER_ADAPTERS_JSON={"IFOOD":"integracoes.ifood.Adapter","RAPPI":"integracoes.rappi.Adapter"}

# Geocodificacao opcional para calcular distancia de entrega no marketplace
# Use {origem}, {destino}, {endereco} ou {filial}, ou deixe sem placeholder para query string.
MARKETPLACE_GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=br&q={endereco}
MARKETPLACE_GEOCODING_TIMEOUT_SEGUNDOS=5

# Senha opcional usada pelo script scripts/backup_local.ps1 para gerar .zip.aes
# Em producao, configure fora do repositorio e proteja o valor.
BACKUP_ENCRYPTION_PASSPHRASE=
# Destino opcional; no Windows local o padrao e %ProgramData%\DeigoVarejo\Backups
LOCAL_BACKUP_DIR=

# Distribuicao do servidor local
LOCAL_SERVER_VERSION=0.1.13
LOCAL_SERVER_PACKAGE_PATH=artifacts/DeigoVarejoServidorLocal.zip
LOCAL_SERVER_REQUIRE_SIGNED_COMMIT=False

# Emissao e fila fiscal
FISCAL_CERTIFICATE_KEY=troque-esta-chave-fiscal-em-producao
FISCAL_SEFAZ_ADAPTER=
# Exemplo de emissão real em homologação:
# FISCAL_SEFAZ_ADAPTER=apps.fiscal.focus_sefaz_adapter.FocusNFeSefazAdapter
FOCUS_NFE_FISCAL_BASE_URL=https://homologacao.focusnfe.com.br
FOCUS_NFE_FISCAL_TOKEN=
FOCUS_NFE_FISCAL_TOKENS_JSON={}
FOCUS_NFE_FISCAL_TIMEOUT_SECONDS=30
FOCUS_NFE_FISCAL_ALLOW_PRODUCTION=False
# Adaptador SOAP direto. Permanece dormente ate ser selecionado e liberado.
# FISCAL_SEFAZ_ADAPTER=apps.fiscal.sefaz_direta.SefazDiretaAdapter
SEFAZ_DIRETA_NETWORK_ENABLED=False
SEFAZ_DIRETA_ALLOW_PRODUCTION=False
SEFAZ_DIRETA_TIMEOUT_SECONDS=30
SEFAZ_DIRETA_ENDPOINTS_JSON={}
# Para receber DF-e diretamente do Ambiente Nacional, substitua FISCAL_DFE_ADAPTER abaixo.
# FISCAL_DFE_ADAPTER=apps.fiscal.sefaz_direta.SefazDiretaDFeAdapter
SEFAZ_DIRETA_DFE_NETWORK_ENABLED=False
SEFAZ_DIRETA_DFE_ALLOW_PRODUCTION=False
SEFAZ_DIRETA_DFE_TIMEOUT_SECONDS=30
SEFAZ_DIRETA_DFE_MAX_XML_BYTES=5242880
SEFAZ_DIRETA_DFE_ENDPOINTS_JSON={}
# Manifestação do Destinatário no Ambiente Nacional. A rede e a produção
# permanecem bloqueadas até a homologação fiscal formal.
# FISCAL_MANIFESTACAO_ADAPTER=apps.fiscal.sefaz_direta.SefazDiretaManifestacaoAdapter
FISCAL_MANIFESTACAO_ADAPTER=
SEFAZ_DIRETA_MANIFESTACAO_NETWORK_ENABLED=False
SEFAZ_DIRETA_MANIFESTACAO_ALLOW_PRODUCTION=False
SEFAZ_DIRETA_MANIFESTACAO_ENDPOINTS_JSON={}
# Carta de Correção Eletrônica (evento 110110) para NF-e modelo 55.
# FISCAL_CCE_ADAPTER=apps.fiscal.sefaz_direta.SefazDiretaCartaCorrecaoAdapter
FISCAL_CCE_ADAPTER=
SEFAZ_DIRETA_CCE_NETWORK_ENABLED=False
SEFAZ_DIRETA_CCE_ALLOW_PRODUCTION=False
# FISCAL_CONSULTA_CADASTRO_ADAPTER=apps.fiscal.sefaz_direta.SefazDiretaConsultaCadastroAdapter
FISCAL_CONSULTA_CADASTRO_ADAPTER=
SEFAZ_DIRETA_CADASTRO_NETWORK_ENABLED=False
SEFAZ_DIRETA_CADASTRO_ALLOW_PRODUCTION=False
FISCAL_UPDATE_MONITOR_ENABLED=False
FISCAL_UPDATE_MONITOR_TIMEOUT_SECONDS=20
FISCAL_UPDATE_MONITOR_SOURCES_JSON=[]

FISCAL_DFE_ADAPTER=apps.fiscal.focus_dfe_adapter.FocusNFeDFeAdapter
# Recebimento de NF-e emitidas contra cada CNPJ pela Focus NFe.
# Use homologacao ate concluir o aceite fiscal. Tokens ficam somente no .env.
FOCUS_NFE_DFE_BASE_URL=https://homologacao.focusnfe.com.br
FOCUS_NFE_DFE_TOKEN=
FOCUS_NFE_DFE_TOKENS_JSON={}
FOCUS_NFE_DFE_TIMEOUT_SECONDS=20
FOCUS_NFE_DFE_FETCH_XML=True
FOCUS_NFE_DFE_ALLOW_PRODUCTION=False
FISCAL_SCHEMA_DIR=fiscal_schemas
FISCAL_NFE_SCHEMA_FILE=nfe_v4.00.xsd
FISCAL_SCHEMA_SHA256=
FISCAL_LOCAL_XML_SIGNATURE_ENABLED=True
FISCAL_AUTO_TRANSMIT_ENABLED=False
FISCAL_AUTO_TRANSMIT_MAX_ATTEMPTS=8
FISCAL_AUTO_TRANSMIT_RETRY_BASE_SECONDS=60
FISCAL_AUTO_TRANSMIT_RETRY_MAX_SECONDS=3600
FISCAL_AUTO_TRANSMIT_LEASE_SECONDS=300

ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
